# Copy to .env.local for local development. On Vercel, set these in
# Project Settings, Environment Variables. Never commit real values.

# Resend: lead popup delivery (server only, never prefixed NEXT_PUBLIC_)
RESEND_API_KEY=
LEAD_TO_EMAIL=atif@aventrio.co
# Must be an address on a domain verified in Resend
LEAD_FROM_EMAIL=Aventrio website <leads@aventrio.co>

# Analytics: leave empty to ship no analytics and no cookie banner.
# Supported: plausible
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=aventrio.co

# Weekly report (GitHub Actions secrets, not Vercel)
GSC_SITE_URL=sc-domain:aventrio.co
GSC_SERVICE_ACCOUNT_JSON=
