{
  "name": "aventrio-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node scripts/validate-site.mjs",
    "check:dashes": "node scripts/check-dashes.mjs",
    "gate": "pnpm check:dashes && pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm validate",
    "report:weekly": "node --experimental-strip-types scripts/weekly-report.ts",
    "report:competitors": "node --experimental-strip-types scripts/competitor-watch.ts"
  },
  "dependencies": {
    "@calcom/embed-react": "1.5.3",
    "framer-motion": "13.5.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
